crystal 0 2.35 -198
platform 0 1.9 -205.2 size=3,0.35,3
crystal 0 2.9 -205.2
platform 0 1.15 -212.2 size=3,0.35,3
crystal 0 2.2 -212.2
platform 0 0.35 -219 size=3.4,0.4,3.4
