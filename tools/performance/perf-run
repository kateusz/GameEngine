#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
# shellcheck source=perf-lib.sh
source "$ROOT/tools/performance/perf-lib.sh"

PRESET=""
REPETITION=1
CONFIGURATION="Release"
WARMUP=5
WARMUP_EXPLICIT=0
MEASURE=5
MEASURE_ITERS=1
SEED=12345
COUNT=""
SCENE=""
EXTRA=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --preset) PRESET="$2"; shift 2 ;;
    --scene) SCENE="$2"; shift 2 ;;
    --count) COUNT="$2"; shift 2 ;;
    --warmup-seconds) WARMUP="$2"; WARMUP_EXPLICIT=1; shift 2 ;;
    --measure-seconds) MEASURE="$2"; shift 2 ;;
    --measure-iterations) MEASURE_ITERS="$2"; shift 2 ;;
    --repetitions) REPETITION="$2"; shift 2 ;;
    --output) OUTPUT="$2"; shift 2 ;;
    --run-dir) RUN_DIR="$2"; shift 2 ;;
    --configuration) CONFIGURATION="$2"; shift 2 ;;
    --project-root|--scene-file)
      EXTRA+=("$1" "$2"); shift 2 ;;
    -h|--help)
      echo "perf-run --preset NAME [--output FILE | --run-dir DIR]  (lista: perf-scenes.json)"
      exit 0 ;;
    *) echo "Unknown: $1" >&2; exit 1 ;;
  esac
done

[[ -z "$PRESET" && -z "$SCENE" ]] && { echo "Pass --preset NAME (see perf-scenes.json)" >&2; exit 1; }

if [[ -n "$PRESET" ]]; then
  IFS='|' read -r SCENE PRESET_COUNT PROJ SCENEFILE _DIM <<< "$(perf_resolve_preset "$PRESET")"
  [[ -z "$COUNT" ]] && COUNT="$PRESET_COUNT"
  [[ -n "$PROJ" ]] && EXTRA+=(--project-root "$PROJ")
  [[ -n "$SCENEFILE" ]] && EXTRA+=(--scene-file "$SCENEFILE")
  [[ $WARMUP_EXPLICIT -eq 0 ]] && WARMUP="$(perf_preset_warmup_seconds "$PRESET")"
fi

[[ -z "$COUNT" ]] && COUNT=1000
if [[ "$SCENE" == "3D:GlbModels" ]]; then
  has_proj=0
  for ((wi = 0; wi < ${#EXTRA[@]}; wi++)); do
    [[ "${EXTRA[wi]}" == "--project-root" ]] && has_proj=1 && break
  done
  if [[ $has_proj -eq 0 ]]; then
    IFS='|' read -r DEF_PROJ DEF_SCENE <<< "$(perf_default_3d_paths)"
    EXTRA+=(--project-root "$DEF_PROJ" --scene-file "$DEF_SCENE")
  fi
fi
if [[ $WARMUP_EXPLICIT -eq 0 && -z "$PRESET" ]]; then
  [[ "$SCENE" == "3D:GlbModels" ]] && WARMUP=10
  for ((wi = 0; wi < ${#EXTRA[@]}; wi++)); do
    [[ "${EXTRA[wi]}" == "--project-root" ]] && WARMUP=10 && break
  done
fi
[[ -z "${OUTPUT:-}" && -z "${RUN_DIR:-}" ]] && { echo "--output or --run-dir required" >&2; exit 1; }

dotnet build "$ROOT/Benchmark/Benchmark.csproj" -c "$CONFIGURATION" -v q >/dev/null
DLL="$ROOT/Benchmark/bin/$CONFIGURATION/net10.0/Benchmark.dll"
COMMON=(--perf-run --scene "$SCENE" --count "$COUNT" --warmup-seconds "$WARMUP" --measure-seconds "$MEASURE" --seed "$SEED" --target-fps 0)
if grep -q MeasureIterations "$ROOT/Benchmark/Cli/PerfRunOptions.cs" 2>/dev/null; then
  COMMON+=(--measure-iterations "$MEASURE_ITERS")
fi

failures=0
for ((i=1; i<=REPETITION; i++)); do
  OUT="${RUN_DIR:+$RUN_DIR/repetition-${i}.json}"
  OUT="${OUT:-$OUTPUT}"
  mkdir -p "$(dirname "$OUT")"
  wall=$((WARMUP + MEASURE * MEASURE_ITERS))
  echo "Run $i/$REPETITION → $OUT (${PRESET:-$SCENE}) warmup=${WARMUP}s measure=${MEASURE}s iters=${MEASURE_ITERS} (wall≈${wall}s + build)"
  set +e
  if ((${#EXTRA[@]})); then
    dotnet exec "$DLL" "${COMMON[@]}" "${EXTRA[@]}" --output "$OUT"
  else
    dotnet exec "$DLL" "${COMMON[@]}" --output "$OUT"
  fi
  code=$?
  set -e
  [[ $code -ne 0 ]] && failures=$((failures + 1))
done

[[ $failures -gt 0 ]] && exit 2
