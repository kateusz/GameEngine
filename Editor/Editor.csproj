<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework Condition="$([MSBuild]::IsOSPlatform('Windows'))">net10.0-windows</TargetFramework>
        <TargetFramework Condition="!$([MSBuild]::IsOSPlatform('Windows'))">net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <EnableMixedModeDebugging>true</EnableMixedModeDebugging>
        <UseWindowsForms Condition="$([MSBuild]::IsOSPlatform('Windows'))">true</UseWindowsForms>
    </PropertyGroup>

    <Import Project="..\Engine\Engine.Shaders.props" />

    <ItemGroup>
        <ProjectReference Include="../Engine/Engine.csproj" />
        <ProjectReference Include="../Ui.ImGui/Ui.ImGui.csproj" />
        <ProjectReference Include="../GameScriptSdk/GameScriptSdk.csproj" ReferenceOutputAssembly="false" />
    </ItemGroup>

    <ItemGroup Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
        <Compile Remove="Platform\WindowsFolderPicker.cs" />
    </ItemGroup>
    <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
        <Compile Remove="Platform\WindowsFolderPicker.Unsupported.cs" />
    </ItemGroup>

    <ItemGroup>
        <!-- Zawsze kopiuj imgui.ini -->
        <None Update="imgui.ini" CopyToOutputDirectory="Always" />

        <!-- Kopiuj rekurencyjnie wszystko z assets i Resources -->
        <None Include="assets/**/*.*" CopyToOutputDirectory="PreserveNewest" />
        <None Include="Resources/**/*.*" CopyToOutputDirectory="PreserveNewest" />
        <None Include="libs/**/*.*" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
      <PackageReference Include="FolderBrowserEx" Version="1.0.1" />
      <!-- Avoid System.Windows.Forms.Application colliding with Engine.Core.Application -->
      <Using Remove="System.Windows.Forms" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="StbImageSharp" Version="2.30.15" />
    </ItemGroup>

    <Target Name="EnsureOutputFolders" BeforeTargets="Build">
        <MakeDir Directories="$(OutputPath)assets;$(OutputPath)assets/fonts;$(OutputPath)assets/fonts/opensans;$(OutputPath)assets/game;$(OutputPath)assets/game/textures;$(OutputPath)assets/shaders;$(OutputPath)assets/shaders/OpenGL;$(OutputPath)assets/textures;$(OutputPath)assets/textures/skybox;$(OutputPath)Resources;$(OutputPath)libs" />
    </Target>

    <Target Name="CopyGameScriptSdk" AfterTargets="Build">
        <PropertyGroup>
            <_SdkStaging>$(MSBuildThisFileDirectory)..\artifacts\GameScriptSdk\$(Configuration)\net10.0\</_SdkStaging>
            <_SdkDest>$(OutputPath)Data\GameScriptSdk\</_SdkDest>
        </PropertyGroup>
        <MakeDir Directories="$(_SdkDest)" />
        <ItemGroup>
            <_SdkFiles Include="$(_SdkStaging)*.dll;$(_SdkStaging)*.pdb" Condition="Exists('$(_SdkStaging)')" />
        </ItemGroup>
        <Copy SourceFiles="@(_SdkFiles)" DestinationFolder="$(_SdkDest)" SkipUnchangedFiles="true" Condition="'@(_SdkFiles)' != ''" />
    </Target>

    <!-- Overlay ImGui.NET's cimgui.dll with the Windows x64 build that includes ImGuizmo. -->
    <Target Name="CopyImGuizmoCimgui" AfterTargets="Build" Condition="$([MSBuild]::IsOSPlatform('Windows'))">
        <PropertyGroup>
            <ImGuizmoCimgui>$(MSBuildThisFileDirectory)native\imguizmo\cimgui.dll</ImGuizmoCimgui>
        </PropertyGroup>
        <Copy SourceFiles="$(ImGuizmoCimgui)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" Condition="Exists('$(ImGuizmoCimgui)')" />
        <Copy SourceFiles="$(ImGuizmoCimgui)" DestinationFolder="$(OutputPath)runtimes\win-x64\native\" SkipUnchangedFiles="true" Condition="Exists('$(ImGuizmoCimgui)') AND Exists('$(OutputPath)runtimes\win-x64\native')" />
    </Target>

    <!-- Copy OpenAL Soft on Windows from NuGet runtimes folder to output root -->
    <Target Name="CopyOpenALNative" AfterTargets="Build" Condition="$([MSBuild]::IsOSPlatform('Windows'))">
        <PropertyGroup>
            <OpenALNativePath>$(USERPROFILE)\.nuget\packages\openal.soft\1.23.1\runtimes\win-x64\native\Release\OpenAL32.dll</OpenALNativePath>
        </PropertyGroup>
        <Warning Text="OpenAL Soft NuGet DLL not found - audio will be disabled." Condition="!Exists('$(OpenALNativePath)')" />
        <Copy SourceFiles="$(OpenALNativePath)" DestinationFolder="$(OutputPath)" Condition="Exists('$(OpenALNativePath)')" />
    </Target>

    <!-- Copy OpenAL Soft dylib on macOS (requires: brew install openal-soft) -->
    <Target Name="CopyOpenALSoftMacOS" AfterTargets="Build" Condition="$([MSBuild]::IsOSPlatform('OSX'))">
        <PropertyGroup>
            <OpenALSoftPathARM>/opt/homebrew/opt/openal-soft/lib/libopenal.1.dylib</OpenALSoftPathARM>
            <OpenALSoftPathARMLib>/opt/homebrew/lib/libopenal.1.dylib</OpenALSoftPathARMLib>
            <OpenALSoftPathX86>/usr/local/opt/openal-soft/lib/libopenal.1.dylib</OpenALSoftPathX86>
            <OpenALSoftPathX86Lib>/usr/local/lib/libopenal.1.dylib</OpenALSoftPathX86Lib>
            <OpenALSoftPath Condition="Exists('$(OpenALSoftPathARM)')">$(OpenALSoftPathARM)</OpenALSoftPath>
            <OpenALSoftPath Condition="'$(OpenALSoftPath)' == '' AND Exists('$(OpenALSoftPathARMLib)')">$(OpenALSoftPathARMLib)</OpenALSoftPath>
            <OpenALSoftPath Condition="'$(OpenALSoftPath)' == '' AND Exists('$(OpenALSoftPathX86)')">$(OpenALSoftPathX86)</OpenALSoftPath>
            <OpenALSoftPath Condition="'$(OpenALSoftPath)' == '' AND Exists('$(OpenALSoftPathX86Lib)')">$(OpenALSoftPathX86Lib)</OpenALSoftPath>
        </PropertyGroup>
        <Warning Text="OpenAL Soft not found - audio effects will be disabled. Run: brew install openal-soft" Condition="'$(OpenALSoftPath)' == ''" />
        <Copy SourceFiles="$(OpenALSoftPath)" DestinationFolder="$(OutputPath)" Condition="'$(OpenALSoftPath)' != ''" />
        <Copy SourceFiles="$(OpenALSoftPath)" DestinationFiles="$(OutputPath)libopenal.dylib" Condition="'$(OpenALSoftPath)' != ''" />
    </Target>

</Project>
